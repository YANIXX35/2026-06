APP_NAME="AntiGaspiCI"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=https://antigaspi-2026.onrender.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- BASE DE DONNÉES (PostgreSQL Render) ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=array

# --- MAIL ---
# Gmail SMTP : MAIL_MAILER=smtp + App Password Gmail (voir README)
# Brevo SMTP : MAIL_MAILER=smtp + credentials Brevo gratuit
# Désactivé  : MAIL_MAILER=log (emails dans storage/logs uniquement)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AntiGaspiCI"

# --- IA GEMINI ---
GEMINI_API_KEY=

# --- SOCIAL AUTH GOOGLE ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://antigaspi-2026.onrender.com/auth/google/callback

# --- SOCIAL AUTH FACEBOOK ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://antigaspi-2026.onrender.com/auth/facebook/callback

VITE_APP_NAME="${APP_NAME}"
